DATABASE_URL="postgresql://routex:routex@localhost:5433/routex?schema=audit"
PORT=4020
SERVICE_NAME=audit
# Origins, which may send client events and telemetry (later only api-gateway).
CORS_ORIGINS=http://localhost:3000
# Read access for the admin panel (same value as ADMIN_API_TOKEN in apps/admin).
ADMIN_API_TOKEN=change-me-admin-token
# Write access for internal services (support, admin, later billing/identity).
AUDIT_INGEST_TOKEN=change-me-ingest-token
# Loki push API (Grafana reads events from there). Empty = events only in the DB.
LOKI_URL=http://localhost:3100
