DATABASE_URL="postgresql://routex:routex@localhost:5433/routex?schema=identity"
PORT=4030
# Base URL for avatar links (later the CDN/gateway URL).
PUBLIC_URL=http://localhost:4030
CORS_ORIGINS=http://localhost:3000
# Signs access tokens; the same value must be in services/billing.
AUTH_TOKEN_SECRET=change-me-at-least-32-random-chars
# Admin panel server access (same as ADMIN_API_TOKEN in apps/admin).
ADMIN_API_TOKEN=change-me-admin-token
# Event journal (services/audit). Empty = events are not sent.
AUDIT_URL=http://localhost:4020
AUDIT_INGEST_TOKEN=change-me-ingest-token
SERVICE_NAME=identity
