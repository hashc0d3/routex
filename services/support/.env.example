DATABASE_URL="postgresql://routex:routex@localhost:5433/routex?schema=support"
PORT=4010
# Через запятую: сайты, которым можно слать заявки напрямую (до появления api-gateway).
CORS_ORIGINS=http://localhost:3000
# Сервисный токен админки. Админка ходит с ним только со своего сервера, в браузер он не попадает.
ADMIN_API_TOKEN=change-me-admin-token
# Event journal (services/audit). Empty = events are not sent.
AUDIT_URL=http://localhost:4020
AUDIT_INGEST_TOKEN=change-me-ingest-token
SERVICE_NAME=support
