# Сервис заявок (Nest). Ходим к нему только с сервера админки.
SUPPORT_API_URL=http://localhost:4010
# Клиенты сайта (identity) и их подписки (billing)
IDENTITY_API_URL=http://localhost:4030
BILLING_API_URL=http://localhost:4040
# Должен совпадать с ADMIN_API_TOKEN в services/support, identity и billing
ADMIN_API_TOKEN=change-me-admin-token

# Первый super admin, если таблица сотрудников пуста. Записи через «;», каждая — вывод
# node scripts/hash-password.mjs <email> <пароль>
ADMIN_USERS=
# Секрет подписи cookie сессии, 32+ символа
ADMIN_SESSION_SECRET=change-me-long-random-secret-string
