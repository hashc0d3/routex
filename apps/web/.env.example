# Пусто = локальный mock (localStorage). Для живого gateway:
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Пока gateway нет: заявки из виджета идут прямо в сервис support (их видит админка).
NEXT_PUBLIC_SUPPORT_API_URL=http://localhost:4010

# Аккаунты (identity) и подписки (billing). Без обоих адресов аккаунт живёт в localStorage (демо).
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:4030
NEXT_PUBLIC_BILLING_API_URL=http://localhost:4040

# Публичный адрес сайта для sitemap.xml и robots.txt
# NEXT_PUBLIC_SITE_URL=https://routex.example
